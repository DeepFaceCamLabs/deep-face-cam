{
  "name": "deep-face-cam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Deep Face Cam — cross-platform desktop app with bundled Python face-swap backend",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prepare:backend": "node scripts/prepare-backend-resource.mjs",
    "models:download": "python3 scripts/download_models.py --required-only",
    "packaging:python:macos": "node scripts/setup-packaging-python.mjs macos",
    "packaging:python:windows:cpu": "node scripts/setup-packaging-python.mjs windows-cpu",
    "packaging:python:windows:directml": "node scripts/setup-packaging-python.mjs windows-directml",
    "packaging:python:windows:cuda": "node scripts/setup-packaging-python.mjs windows-cuda",
    "sidecar:macos": "node scripts/build-macos-sidecar.mjs",
    "sidecar:windows": "node scripts/build-windows-sidecar.mjs",
    "sign:macos": "node scripts/sign-macos-app.mjs",
    "notarize:macos": "node scripts/notarize-macos-dmg.mjs",
    "dmg:macos": "node scripts/build-macos-dmg.mjs",
    "preview": "vite preview --port 4173",
    "backend": "node scripts/run-backend.mjs",
    "open-source:check": "node scripts/check-open-source-ready.mjs",
    "release:checksums": "node scripts/create-checksums.mjs",
    "release:rename-windows": "node scripts/rename-windows-artifacts.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:macos": "npm run sidecar:macos && npm run prepare:backend && tauri build --bundles app && npm run dmg:macos",
    "tauri:build:macos:signed": "npm run sidecar:macos && npm run prepare:backend && tauri build --bundles app && npm run sign:macos && MACOS_SIGN_DMG=1 npm run dmg:macos",
    "tauri:build:macos:notarized": "MACOS_NESTED_TIMESTAMP=1 npm run tauri:build:macos:signed && npm run notarize:macos",
    "tauri:build:windows": "npm run sidecar:windows && npm run prepare:backend && tauri build --bundles msi",
    "tauri:build:windows:msi": "npm run sidecar:windows && npm run prepare:backend && tauri build --bundles msi"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
